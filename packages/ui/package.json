{
  "name": "@swapdeck/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interfaccia condivisa tra app desktop ed estensione VS Code",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/dev/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@swapdeck/types": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^26.0.0",
    "typescript": "catalog:",
    "vite": "^6.4.0",
    "vitest": "catalog:"
  }
}
