{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM e JSX solo perché `MessageBackend` usa i tipi di `@swapdeck/ui` (componenti React).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@swapdeck/types": ["../types/src/index.ts"] }
  },
  "include": ["src", "protocol.json"]
}
