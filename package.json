{
  "name": "swapdeck-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "prettier --check . && pnpm -r typecheck",
    "format": "prettier --write .",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "dist:local": "node scripts/dist-local.mjs",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "gen:types": "pnpm --filter @swapdeck/types gen:types && pnpm --filter swapdeck-vscode gen:types"
  },
  "devDependencies": {
    "prettier": "catalog:"
  }
}
