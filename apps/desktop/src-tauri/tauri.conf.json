{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwapDeck",
  "mainBinaryName": "swapdeck",
  "identifier": "com.swapdeck.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SwapDeck",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "SwapDeck",
    "category": "Utility",
    "shortDescription": "Monitor e gestione degli account di cswap",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "Italian": "./windows/Italian.nsh" },
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NkQ1REVGRTczODM0MzkKUldRNU5Eam43MTF0bHhUWW9nMjZ4Q0c2L1FkQ3k4WEFpRU5Janh6VDRhRGFBa2k5RTdMUFBiSjEK",
      "endpoints": ["https://github.com/Gian20luca/SwapDeck/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
