{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Finestra principale: lettura, azioni di cswap, impostazioni dell'app.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-accounts",
    "allow-get-status",
    "allow-get-config",
    "allow-get-config-value",
    "allow-get-history",
    "allow-confirmation-for",
    "allow-run-action",
    "allow-get-app-settings",
    "allow-set-autostart",
    "allow-get-snapshot",
    "allow-diagnose-setup",
    "allow-install-cswap",
    "allow-upgrade-cswap",
    "allow-check-cswap-update",
    "allow-dismiss-cswap-update"
  ]
}
