{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Finestra principale: lettura, azioni di cswap, impostazioni dell'app, regole del motore, preferenze, storico, selettori di file e cartelle.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-accounts",
    "allow-get-status",
    "allow-get-config",
    "allow-get-config-value",
    "allow-get-history",
    "allow-confirmation-for",
    "allow-run-action",
    "allow-get-app-settings",
    "allow-set-autostart",
    "allow-get-snapshot",
    "allow-list-mappings",
    "allow-get-engine-state",
    "allow-set-engine-rules",
    "allow-get-engine-profiles",
    "allow-apply-engine-profile",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-get-notification-settings",
    "allow-set-notification-settings",
    "allow-get-history-events",
    "allow-get-usage-breakdown",
    "allow-get-diagnostics",
    "allow-open-logs-folder",
    "allow-diagnose-setup",
    "allow-install-cswap",
    "allow-upgrade-cswap",
    "allow-check-cswap-update",
    "allow-dismiss-cswap-update"
  ]
}
