{
  "name": "swapdeck-vscode",
  "displayName": "SwapDeck",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "swapdeck",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "swapdeck.showView",
        "title": "%command.showView%",
        "category": "SwapDeck"
      },
      {
        "command": "swapdeck.openPanel",
        "title": "%command.openPanel%",
        "category": "SwapDeck",
        "icon": "$(link-external)"
      },
      {
        "command": "swapdeck.refresh",
        "title": "%command.refresh%",
        "category": "SwapDeck",
        "icon": "$(refresh)"
      },
      {
        "command": "swapdeck.switchAccount",
        "title": "%command.switchAccount%",
        "category": "SwapDeck"
      },
      {
        "command": "swapdeck.switchMap",
        "title": "%command.switchMap%",
        "category": "SwapDeck"
      },
      {
        "command": "swapdeck.startEngine",
        "title": "%command.startEngine%",
        "category": "SwapDeck"
      },
      {
        "command": "swapdeck.stopEngine",
        "title": "%command.stopEngine%",
        "category": "SwapDeck"
      },
      {
        "command": "swapdeck.copyDiagnostics",
        "title": "%command.copyDiagnostics%",
        "category": "SwapDeck"
      },
      {
        "command": "swapdeck.openLogsFolder",
        "title": "%command.openLogsFolder%",
        "category": "SwapDeck"
      }
    ],
    "configuration": {
      "title": "SwapDeck",
      "properties": {
        "swapdeck.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "scope": "application",
          "markdownDescription": "%config.refreshIntervalSeconds%"
        },
        "swapdeck.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.cliPath%"
        },
        "swapdeck.engine.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%config.engine.enabled%"
        },
        "swapdeck.notifications.thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "maxItems": 5,
          "default": [
            80,
            95
          ],
          "scope": "application",
          "markdownDescription": "%config.notifications.thresholds%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swapdeck",
          "title": "SwapDeck",
          "icon": "media/swapdeck.svg"
        }
      ]
    },
    "views": {
      "swapdeck": [
        {
          "type": "webview",
          "id": "swapdeck.view",
          "name": "SwapDeck",
          "icon": "media/swapdeck.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "swapdeck.refresh",
          "when": "view == swapdeck.view",
          "group": "navigation@1"
        },
        {
          "command": "swapdeck.openPanel",
          "when": "view == swapdeck.view",
          "group": "navigation@2"
        },
        {
          "command": "swapdeck.copyDiagnostics",
          "when": "view == swapdeck.view",
          "group": "diagnostics@1"
        },
        {
          "command": "swapdeck.openLogsFolder",
          "when": "view == swapdeck.view",
          "group": "diagnostics@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ext": "node scripts/build.mjs && node scripts/run-ext-tests.mjs",
    "package": "node scripts/package.mjs --target win32-x64",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "devDependencies": {
    "@swapdeck/types": "workspace:*",
    "@swapdeck/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "~1.95.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "~3.9.2",
    "esbuild": "^0.25.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
